# Copy these into Vercel > Project > Settings > Environment Variables
# (mark every one as "Sensitive"). NEVER commit real values and NEVER prefix them with VITE_.

# Admin login — use a long random passphrase (20+ characters)
ADMIN_PASSWORD=
# Random string, 40+ characters (signs the login cookie)
SESSION_SECRET=

# Google Apps Script Web App URL (ends with /exec) and the same API_SECRET you put in Script Properties
GAS_URL=
GAS_SECRET=

# Vercel > Settings > Git > Deploy Hooks (rebuilds the site when an article is published/edited/deleted)
DEPLOY_HOOK_URL=
